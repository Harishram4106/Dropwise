# Copy to .env (git-ignored). The gateway holds no provider keys: Bifrost does.

# Where requests go after Dropwise: Bifrost's OpenAI-compatible endpoint.
BIFROST_URL=http://localhost:8080
# The intelligence API (classifier + signed Evidence Registry).
INTELLIGENCE_URL=http://localhost:8787

# Right-sizing: an easy prompt asked of LARGE_MODEL (or of "dropwise/auto") is sent to SMALL_MODEL.
SMALL_MODEL=anthropic/claude-haiku-5-5
LARGE_MODEL=anthropic/claude-opus-5-5
# Turn a lever off (the quality guard's fallback is ROUTING=off: caching and budgets only).
ROUTING=on
CACHE=on
CACHE_TTL_SECONDS=3600

# What receipts and budgets count by default: direct_plus_indirect or direct_only.
SCOPE=direct_plus_indirect
# Characters of the prompt kept in each receipt for the dashboard; 0 keeps none.
PROMPT_PREVIEW_CHARS=80

PORT=8088
# Restrict CORS to the dashboard's origin (defaults to *).
DASHBOARD_ORIGIN=http://localhost:3000

# Benchmark only (npm run bench): sent to Bifrost in both runs if your Bifrost requires a virtual key.
BIFROST_VIRTUAL_KEY=
